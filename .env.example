# Docker Compose reads .env; never commit real keys.
# CARTO key is browser-visible. Restrict it to your website in CARTO.
CARTO_BASEMAP_API_KEY=

# Required for passkeys on a public deployment (RP_ID has no scheme or port).
RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:30045
RP_NAME=Web Traffic Map

# Optional AI analysis; unset key/model keeps heuristic detection.
OPEN_AI_API_URL=https://openrouter.ai/api/v1/chat/completions
OPEN_AI_API_KEY=
OPEN_AI_API_MODEL=

# Optional JWT secret; otherwise generated and persisted in the database.
# JWT_SECRET=
# JWT_EXPIRY=7d

# Native Node deployment settings; Compose sets its own container paths/port.
# PORT=30045
# DB_PATH=./data/traffic.db
# LOG_DIR=./nginx-logs
