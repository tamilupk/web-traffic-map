{
  "name": "web-traffic-map",
  "version": "1.0.0",
  "description": "Web traffic visualization tool that parses nginx access logs and displays visitor locations on an interactive map",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch --inspect src/index.js",
    "invite": "node scripts/invite.js",
    "promote-admin": "node scripts/promote-admin.js",
    "docker:build": "docker build -t web-traffic-map .",
    "docker:run": "docker-compose up -d",
    "docker:stop": "docker-compose down",
    "test": "node --test test/*.test.js"
  },
  "keywords": [
    "nginx",
    "logs",
    "traffic",
    "analytics",
    "map",
    "visualization",
    "geolocation"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "@simplewebauthn/server": "^14.0.3",
    "better-sqlite3": "^13.0.3",
    "chokidar": "^5.0.0",
    "hono": "^4.13.12",
    "jose": "^6.2.12",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "jsdom": "^26.1.0"
  }
}
